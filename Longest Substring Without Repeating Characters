class Solution {
    public int lengthOfLongestSubstring(String s) {

        int max = 0;
        int start = 0;

        for (int end = 0; end < s.length(); end++) {

            // Check if current character already exists
            for (int i = start; i < end; i++) {

                if (s.charAt(i) == s.charAt(end)) {
                    start = i + 1;
                    break;
                }
            }

            int length = end - start + 1;

            if (length > max) {
                max = length;
            }
        }

        return max;
    }
}
